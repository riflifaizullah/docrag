@inject ChatState Chat
@inject UiStrings T
@inject ApiClient Api
@implements IDisposable

<div class="rag-main" style="flex-grow: 1; height: 100%; display: flex; flex-direction: column; min-width: 0; position: relative;">

    @if (SidebarCollapsed)
    {
        <button class="rag-sidebar-reopen" @onclick="OnExpandSidebar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            RAG SYSTEM
        </button>
    }

    <div class="rag-header" style="@(SidebarCollapsed ? "padding-left: 150px;" : "")">
        <div class="rag-brand-title rag-header-title">RAG SYSTEM</div>
        <div style="font-size: 12px; color: var(--text-faint); margin-top: 2px;">@T["new_session"]</div>
    </div>

    <div class="rag-scroll rag-pad-x" style="flex-grow: 1; overflow-y: auto; padding-top: 28px; padding-bottom: 28px; display: flex; flex-direction: column;">
        @if (Chat.Messages.Count == 0)
        {
            <div class="rag-empty">
                <div class="rag-mark" style="width: 46px; height: 46px; border-radius: 13px;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 2h9l5 5v15H6z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M9 12h7M9 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
                </div>
                <div class="rag-empty-title">@T["empty_title"]</div>
                <p class="rag-empty-hint">@T["empty_hint"]</p>
                @if (_starters.Count > 0)
                {
                    <div class="rag-meta-label" style="margin-top: 14px;">@T["try_asking"]</div>
                    <div class="rag-starters">
                        @foreach (var doc in _starters)
                        {
                            <button class="rag-starter" title="@doc.Filename" @onclick="() => AskAboutAsync(doc)">
                                <span class="rag-starter-verb">@T["summarize"]</span>
                                <span class="rag-starter-title">@(string.IsNullOrWhiteSpace(doc.Type) || doc.Type is "Unknown" or "Tidak diketahui" ? doc.Filename : doc.Type)</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="rag-thread">
                @foreach (var message in Chat.Messages)
                {
                    @if (message.IsAssistant)
                    {
                        <div class="rag-answer-row">
                            <div class="rag-mark" style="width: 28px; height: 28px; border-radius: 8px; margin-top: 2px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 2h9l5 5v15H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
                            </div>
                            <div class="rag-answer">
                                <div class="rag-answer-body">@((MarkupString)message.FormattedHtml)</div>

                                @if (message.Notes.Count > 0)
                                {
                                    <div class="rag-notes">
                                        @foreach (var note in message.Notes)
                                        {
                                            <div>@note</div>
                                        }
                                    </div>
                                }

                                @if (message.Sources.Count > 0)
                                {
                                    <div class="rag-meta">
                                        <div class="rag-meta-label">@T["sources"]</div>
                                        <div class="rag-chips">
                                            @foreach (var source in message.Sources)
                                            {
                                                <button class="rag-chip" title="@source" @onclick="() => OnSourceClick.InvokeAsync(source)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0;"><path d="M6 2h8l5 5v15H6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
                                                    <span>@source</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }

                                <div style="margin-top: 10px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 14px;">
                                    <div class="rag-disclaimer">@T["disclaimer"]</div>

                                    @if (message.CanFlag)
                                    {
                                        @if (message.IsFlagged)
                                        {
                                            <span class="rag-disclaimer">&#10003; @T["flagged"]</span>
                                        }
                                        else if (_flaggingMessage != message)
                                        {
                                            <button class="rag-flag-btn" style="font-size: 11.5px; font-weight: 600; display: flex; align-items: center; gap: 4px;"
                                                    @onclick="() => _flaggingMessage = message">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 3v18l7-4 7 4V3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
                                                @T["flag"]
                                            </button>
                                        }
                                    }
                                </div>

                                @if (message.FlagError is not null)
                                {
                                    <div style="margin-top: 6px; font-size: 11.5px; color: var(--danger);">@message.FlagError</div>
                                }

                                @if (message.CanFlag && !message.IsFlagged && _flaggingMessage == message)
                                {
                                    <div class="rag-chips" style="margin-top: 8px; align-items: center;">
                                        @foreach (var value in FlagCategories)
                                        {
                                            <button class="rag-chip" @onclick="() => SubmitFlagAsync(message, value)">@T["flag_" + value]</button>
                                        }
                                        <button class="rag-flag-btn" style="font-size: 11.5px; font-weight: 600;" @onclick="() => _flaggingMessage = null">@T["cancel"]</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rag-user">@message.Text</div>
                    }
                }
                @if (Chat.IsBusy)
                {
                    <div class="rag-answer-row" style="align-items: center;" role="status" aria-label="@T["typing"]">
                        <div class="rag-mark" style="width: 28px; height: 28px; border-radius: 8px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 2h9l5 5v15H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
                        </div>
                        <div class="rag-typing" aria-hidden="true"><i></i><i></i><i></i></div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Chat.ShowCandidateBar)
    {
        <div class="rag-candidates">
            <div class="rag-candidates-inner">
                <div style="flex-grow: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px;">
                    <div class="rag-meta-label">@T["pick_document"]</div>
                    <div class="rag-chips rag-scroll">
                        @foreach (var candidate in Chat.CandidateDocuments)
                        {
                            <button class="rag-chip" title="@candidate" @onclick="() => PickCandidateAsync(candidate)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0;"><path d="M6 2h8l5 5v15H6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
                                <span>@candidate</span>
                            </button>
                        }
                    </div>
                </div>
                <button class="rag-icon-btn" style="width: 26px; height: 26px; flex-shrink: 0;" @onclick="() => Chat.DismissCandidates()" aria-label="@T["close"]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path></svg>
                </button>
            </div>
        </div>
    }

    <div class="rag-composer-wrap">
        <div class="rag-composer-inner">
            <div class="rag-composer" style="display: flex; align-items: center; gap: 10px; border-radius: 16px; padding: 7px 8px 7px 18px;">
                <input placeholder="@T["composer_placeholder"]" aria-label="@T["composer_placeholder"]" style="flex-grow: 1; font-size: 14px; padding: 6px 0;"
                       value="@Chat.InputText" @oninput="OnInputChanged" @onkeydown="OnComposerKeyDown" />
                <button class="rag-btn-primary" style="width: 36px; height: 36px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"
                        aria-label="@T["send"]" disabled="@(!Chat.CanSend)" @onclick="SendAsync">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="var(--accent-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </button>
            </div>
            <div class="rag-hint"><span class="rag-kbd">Enter</span> @T["composer_hint"]</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool SidebarCollapsed { get; set; }
    [Parameter] public EventCallback OnExpandSidebar { get; set; }
    [Parameter] public EventCallback<string> OnSourceClick { get; set; }

    private static readonly string[] FlagCategories =
        ["hallucinated_fact", "wrongly_refused", "bad_retrieval", "incomplete_or_unclear", "other"];

    private ChatMessageState? _flaggingMessage;

    private List<DocumentInfo> _starters = [];

    protected override async Task OnInitializedAsync()
    {
        Chat.Changed += OnChatChanged;
        try { _starters = (await Api.GetDocumentsAsync()).Take(3).ToList(); }
        catch { _starters = []; }
    }

    private async Task AskAboutAsync(DocumentInfo doc)
    {
        Chat.InputText = $"{T["summarize"]} {doc.Filename}";
        await SendAsync();
    }
    private void OnChatChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Chat.Changed -= OnChatChanged;

    private void OnInputChanged(ChangeEventArgs e)
    {
        Chat.InputText = e.Value?.ToString() ?? "";
    }

    private async Task OnComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    private async Task SendAsync()
    {
        await Chat.SendAsync();
        StateHasChanged();
    }

    private async Task PickCandidateAsync(string filename)
    {
        await Chat.PickCandidateAsync(filename);
        StateHasChanged();
    }

    private async Task SubmitFlagAsync(ChatMessageState message, string category)
    {
        _flaggingMessage = null;
        await Chat.FlagMessageAsync(message, category);
        StateHasChanged();
    }
}
